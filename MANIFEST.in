include LICENSE THIRD_PARTY_NOTICES.md requirements.txt
include docs/KNOWN_ISSUES.md docs/source_manifest.json
recursive-include results/paper *.txt *.csv *.md
recursive-include tests *.py
prune external
prune .local-backups
prune .validation
global-exclude __pycache__ *.py[cod] *.pth *.pth.tar *.pt *.ckpt *.pdf
